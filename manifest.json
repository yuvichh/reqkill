{
    "name": "Aifiesta Unlimited Chat",
     "description": "Blocks all requests to /chat/message-count",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["https://api-v2.aifiesta.ai/*"],
    "declarative_net_request": {
      "rule_resources": [
        {
          "id": "ruleset_1",
          "enabled": true,
          "path": "rules.json"
        }
      ]
    }
  }